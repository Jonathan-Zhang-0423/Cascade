# Cascade test environment variables
# Copy to `.env.test` and fill in TEST_DATABASE_URL to enable integration/stress tests.
# Without TEST_DATABASE_URL, integration & stress tests auto-skip (unit tests still run).

# ── Test database ──────────────────────────────────────────
# REQUIRED for integration/stress tests. MUST be a SEPARATE database from your
# dev DB — the suite TRUNCATEs all tables between tests. Never point this at a
# database with data you care about.
# Example: postgresql://user:pass@localhost:5432/cascade_test
TEST_DATABASE_URL=

# ── AI providers ───────────────────────────────────────────
# Integration/stress tests MOCK all AI calls, so these can be dummy values.
# A non-empty DOUBAO_API_KEY is required only because some routes guard on its
# presence before doing any work (and the mock intercepts the actual call).
DOUBAO_API_KEY=test-key

# ── E2E only ───────────────────────────────────────────────
# Playwright E2E runs the real app. Set MOCK_AI=1 to force deterministic mocked
# streaming responses (CI-safe). Leave unset to hit real providers (needs a real
# DOUBAO_API_KEY and network access to the provider).
MOCK_AI=1
