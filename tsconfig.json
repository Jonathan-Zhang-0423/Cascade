{
  "extends": "./tsconfig.base.json",
  "include": [
    "frontend/web/src/**/*",
    "backend/api/src/**/*",
    "database/schema/**/*",
    "shared/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "**/*.test.ts",
    "backend/api/artifacts/**",
    "backend/api/src/worker-entry.ts"
  ],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./frontend/web/src/*"],
      "@shared/*": ["./shared/src/*"],
      "@cascade/shared": ["./shared/src/index.ts"],
      "@cascade/database": ["./database/schema/index.ts"]
    }
  }
}
