# Cascade environment variables
# Copy this file to `.env` and fill in your values.
# Required keys are marked REQUIRED — the app won't start without them.

# ── Database ───────────────────────────────────────────────
# REQUIRED. Postgres connection string (Neon, Supabase, local, etc.)
# Example: postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# ── AI providers ───────────────────────────────────────────
# REQUIRED. Doubao is the hard-coded fallback for several routes.
DOUBAO_API_KEY=

# OPTIONAL. Configure any subset; the app uses whatever is available.
KIMI_API_KEY=
MINIMAX_API_KEY=
GLM_API_KEY=
DEEPSEEK_API_KEY=

# ── GitHub OAuth (optional) ────────────────────────────────
# Set both to enable the "Sign in with GitHub" flow.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APP_BASE_URL=

# ── Dev-only ───────────────────────────────────────────────
# Local HTTP proxy for outbound requests (GitHub OAuth, npm, etc.)
# Leave blank if you don't need a proxy.
HTTPS_PROXY=

# Dev server port. Defaults to 5000 if unset.
PORT=

# Set to "1" to allow agents to run shell commands inside the build sandbox.
# Off by default for safety.
ENABLE_SHELL=

# ── Waitlist / invite system ───────────────────────────────
# Resend API key for transactional emails (waitlist confirmations, invite
# codes, admin batch alerts). Without it, email sends are skipped and logged.
RESEND_API_KEY=

# Shared secret for the /admin panel and the email-link batch confirmation.
# Anyone with this value can read the waitlist and trigger invite sends.
ADMIN_SECRET=

# Public base URL used in email links (invite redemption page, batch confirm).
# Falls back to APP_BASE_URL if unset.
BASE_URL=

# Verified Resend "from" identity. Defaults to "CascadeAI <noreply@cascadeai.co>".
FROM_EMAIL=

# Address that receives admin batch alerts. Defaults to jonathan@cascadeai.co.
NOTIFICATION_EMAIL=

# ── 飞书多维表格同步 (optional) ────────────────────────────
# 企业自建应用凭证，在 open.feishu.cn 开发者后台获取
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 多维表格地址栏中的 token（/base/{APP_TOKEN} 部分）
# 默认值已硬编码，可通过此变量覆盖
FEISHU_BITABLE_APP_TOKEN=

# 具体表的 ID（URL 中 table= 后面的部分）
FEISHU_BITABLE_TABLE_ID=
