# Cascade environment variables
# Copy this file to `.env` and fill in your values.
# Required keys are marked REQUIRED — the app won't start without them.

# ── Database ───────────────────────────────────────────────
# REQUIRED. Postgres connection string (Neon, Supabase, local, etc.)
# Example: postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# ── AI providers ───────────────────────────────────────────
# REQUIRED. Doubao is the hard-coded fallback for several routes.
DOUBAO_API_KEY=

# OPTIONAL. Configure any subset; the app uses whatever is available.
KIMI_API_KEY=
MINIMAX_API_KEY=
GLM_API_KEY=
# 智谱模型型号，可选 glm-5.2 / glm-4.6 / glm-4-plus 等，不填默认 glm-5.2
GLM_MODEL=glm-5.2

# ── 站点备案（前端 Vite 变量，构建时注入；缺省则不展示对应条目）──
# ICP 备案号，链接至工信部 https://beian.miit.gov.cn
VITE_ICP_BEIAN=
# 公安联网备案 32 位数据码，链接至 https://beian.mps.gov.cn
VITE_GONGAN_DATACODE=
# 公安备案展示文案（可选，缺省为“公安联网备案”）
VITE_GONGAN_TEXT=
DEEPSEEK_API_KEY=

# ── GitHub OAuth (optional) ────────────────────────────────
# Set both to enable the "Sign in with GitHub" flow.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APP_BASE_URL=

# ── Dev-only ───────────────────────────────────────────────
# Local HTTP proxy for outbound requests (GitHub OAuth, npm, etc.)
# Leave blank if you don't need a proxy.
HTTPS_PROXY=

# Dev server port. Defaults to 5000 if unset.
PORT=

# Set to "1" to allow agents to run shell commands inside the build sandbox.
# Off by default for safety.
ENABLE_SHELL=

# ── Waitlist / invite system ───────────────────────────────
# Resend API key for transactional emails (waitlist confirmations, invite
# codes, admin batch alerts). Without it, email sends are skipped and logged.
RESEND_API_KEY=

# Shared secret for the /admin panel and the email-link batch confirmation.
# Anyone with this value can read the waitlist and trigger invite sends.
ADMIN_SECRET=

# Public base URL used in email links (invite redemption page, batch confirm).
# Falls back to APP_BASE_URL if unset.
BASE_URL=

# Verified Resend "from" identity. Defaults to "CascadeAI <noreply@cascadeai.co>".
FROM_EMAIL=

# Address that receives admin batch alerts. Defaults to jonathan@cascadeai.co.
NOTIFICATION_EMAIL=

# ── SMS (Tencent Cloud) ────────────────────────────────────
# Used to send OTP codes for phone-number login. If any of these are unset,
# SMS sends are skipped and the OTP code is logged to the server console
# (same dev-fallback pattern as RESEND_API_KEY).
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID_OTP=
# Defaults to ap-guangzhou.
TENCENT_SMS_REGION=

# ── 人机验证 (Tencent Cloud Captcha / 天御) ────────────────
# 防机器人刷接口（注册/登录/发码）。控制台【验证管理】>【基础配置】获取
# CaptchaAppId 与 AppSecretKey。任一缺失则验票降级放行（与 SMS 同策略）。
# 注意：人机验证不替代 OTP 发送频率限制，两者叠加才完整。
TENCENT_CAPTCHA_APP_ID=
TENCENT_CAPTCHA_APP_SECRET_KEY=
# 验票 API 凭证；留空则复用上面的 TENCENT_SMS_SECRET_ID / _KEY。
TENCENT_CAPTCHA_SECRET_ID=
TENCENT_CAPTCHA_SECRET_KEY=

# ── 飞书多维表格同步 (optional) ────────────────────────────
# 企业自建应用凭证，在 open.feishu.cn 开发者后台获取
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 多维表格地址栏中的 token（/base/{APP_TOKEN} 部分）
# 默认值已硬编码，可通过此变量覆盖
FEISHU_BITABLE_APP_TOKEN=

# 具体表的 ID（URL 中 table= 后面的部分）
FEISHU_BITABLE_TABLE_ID=
